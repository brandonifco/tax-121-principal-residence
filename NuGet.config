<?xml version="1.0" encoding="utf-8"?>
<!-- Adopted from rules-factory's managed recipe 2 (decision 0018), so this file is now the
     engine's own and `factory produce` will not rewrite it.

     Why it diverges: the map RulesFactory.Maps.Tax121PrincipalResidence has not been published to
     nuget.org, so restore cannot find it there. The local feed below holds the very .nupkg that
     `tools/pack-map.py` produced and gated. packages.lock.json still pins every content hash, and
     the mapping confines the local feed to that one package id. Everything else, the kernel
     included, still comes from nuget.org and nowhere else.

     The feed is a directory inside this repository, so the engine restores anywhere it is
     cloned. The package there is the one pack-map.py produced and gated, and provenance.json
     records its sha256, so it is checkable rather than merely present.

     When the map is published to nuget.org, reset this file to the factory's recipe with
     produce's reset flag and delete local-feed/. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="tax-121-local" value="./local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="tax-121-local">
      <package pattern="RulesFactory.Maps.Tax121PrincipalResidence" />
    </packageSource>
  </packageSourceMapping>
</configuration>
